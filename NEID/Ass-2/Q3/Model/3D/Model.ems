'@ define curve circle: curve1:profile1

'[VERSION]2024.0|33.0.1|20230901[/VERSION]
With Circle
     .Reset 
     .Name "profile1" 
     .Curve "curve1" 
     .Radius "0.322" 
     .Xcenter "5" 
     .Ycenter "5" 
     .Segments "0" 
     .Create
End With

'@ transform curve: rotate curve1:profile1

'[VERSION]2024.0|33.0.1|20230901[/VERSION]
With Transform 
     .Reset 
     .Name "curve1:profile1" 
     .Origin "Free" 
     .Center "5", "5", "0" 
     .Angle "90", "0", "0" 
     .MultipleObjects "False" 
     .GroupObjects "False" 
     .Repetitions "1" 
     .MultipleSelection "False" 
     .Transform "Curve", "Rotate" 
End With

'@ define coil: coil1

'[VERSION]2024.0|33.0.1|20230901[/VERSION]
With Coil
     .Reset
     .Name "coil1"
     .Type "Coil"
     .OperationMode "Current"
     .ConductorModel "Stranded"
     .ToolType "CurveCurve"
     .Value "100"
     .Phase "0.0"
     .NTurns "1"
     .Resistance "0.0"
     .NStrands "120"
     .StrandDiameter "0.05"
     .LengthExtension "1.2"
     .CurrentDirection "Regular"
     .ProjectProfileToPathAdvanced "True"
     .ProfileName "curve1:profile1"
     .PathName "curve1:path1"
     .Create
End With

'@ define curve circle: curve1:profile2

'[VERSION]2024.0|33.0.1|20230901[/VERSION]
With Circle
     .Reset 
     .Name "profile2" 
     .Curve "curve1" 
     .Radius "0.322" 
     .Xcenter "5" 
     .Ycenter "-5" 
     .Segments "0" 
     .Create
End With

'@ transform curve: rotate curve1:profile2

'[VERSION]2024.0|33.0.1|20230901[/VERSION]
With Transform 
     .Reset 
     .Name "curve1:profile2" 
     .Origin "ShapeCenter" 
     .Center "0", "0", "0" 
     .Angle "90", "0", "0" 
     .MultipleObjects "False" 
     .GroupObjects "False" 
     .Repetitions "1" 
     .MultipleSelection "False" 
     .Transform "Curve", "Rotate" 
End With

'@ define coil: coil2

'[VERSION]2024.0|33.0.1|20230901[/VERSION]
With Coil

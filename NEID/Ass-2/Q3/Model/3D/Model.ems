'# EMS Version: Version 2024.0 - Sep 01 2023 - ACIS 33.0.1 -

'# length = mm
'# frequency = kHz
'# time = s
'# frequency range: fmin = 0.0 fmax = 0.0
'# created = '[VERSION]2024.0|33.0.1|20230901[/VERSION]


'@ define units

'[VERSION]2024.0|33.0.1|20230901[/VERSION]
With Units 
     .SetUnit "Length", "mm"
     .SetUnit "Temperature", "degC"
     .SetUnit "Voltage", "V"
     .SetUnit "Current", "A"
     .SetUnit "Resistance", "Ohm"
     .SetUnit "Conductance", "S"
     .SetUnit "Capacitance", "F"
     .SetUnit "Inductance", "H"
     .SetUnit "Frequency", "kHz"
     .SetUnit "Time", "s"
     .SetResultUnit "frequency", "frequency", "" 
End With

'@ change solver type

'[VERSION]2024.0|33.0.1|20230901[/VERSION]
ChangeSolverType "LF Frequency Domain"

'@ define lf solver frequency settings

'[VERSION]2024.0|33.0.1|20230901[/VERSION]
With LFSolver
     .ResetFrequencySettings 
     .AddFrequency "1" 
End With

'@ define boundaries

'[VERSION]2024.0|33.0.1|20230901[/VERSION]
With Boundary
     .Xmin "electric"
     .Xmax "electric"
     .Ymin "electric"
     .Ymax "electric"
     .Zmin "magnetic"
     .Zmax "magnetic"
     .Xsymmetry "none"
     .Ysymmetry "none"
     .Zsymmetry "none"
     .ApplyInAllDirections "False"
     .XminPotential ""
     .XminPotentialType "None"
     .XmaxPotential ""
     .XmaxPotentialType "None"
     .YminPotential ""
     .YminPotentialType "None"
     .YmaxPotential ""
     .YmaxPotentialType "None"
End With

'@ new component: component1

'[VERSION]2024.0|33.0.1|20230901[/VERSION]
Component.New "component1"

'@ define curve circle: curve1:path1

'[VERSION]2024.0|33.0.1|20230901[/VERSION]
With Circle
     .Reset 
     .Name "path1" 
     .Curve "curve1" 
     .Radius "5" 
     .Xcenter "0" 
     .Ycenter "5+0.322+0.1" 
     .Segments "0" 
     .Create
End With


'@ define curve circle: curve1:path2

'[VERSION]2024.0|33.0.1|20230901[/VERSION]
With Circle
     .Reset 
     .Name "path2" 
     .Curve "curve1" 
     .Radius "5" 
     .Xcenter "0" 
     .Ycenter "-(5+0.322+0.1)" 
     .Segments "0" 
     .Create
End With



'@ define background

'[VERSION]2024.0|33.0.1|20230901[/VERSION]
With Background 
     .ResetBackground 
     .XminSpace "25" 
     .XmaxSpace "25" 
     .YminSpace "25" 
     .YmaxSpace "25" 
     .ZminSpace "25" 
     .ZmaxSpace "25" 
     .ApplyInAllDirections "False" 
End With 

With Material 

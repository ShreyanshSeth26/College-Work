     .Type "Coil"
     .OperationMode "Current"
     .ConductorModel "Stranded"
     .ToolType "CurveCurve"
     .Value "100"
     .Phase "0.0"
     .NTurns "1"
     .Resistance "0.0"
     .NStrands "120"
     .StrandDiameter "0.05"
     .LengthExtension "1.2"
     .CurrentDirection "Inverted"
     .ProjectProfileToPathAdvanced "True"
     .ProfileName "curve1:profile2"
     .PathName "curve1:path2"
     .Create
End With

'@ change coil direction: coil1

